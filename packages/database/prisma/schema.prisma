// =============================================================================
// Global Accounting Platform — Prisma schema
//
// Conventions (enforced by review and by tests in src/schema.test.ts):
//   * Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
//   * Timestamps are timestamptz.
//   * Monetary amounts use Decimal @db.Decimal(20, 4). Float is forbidden.
//   * Tables and columns are snake_case via @@map / @map.
//   * Every tenant-owned table has organization_id and PostgreSQL RLS.
//   * Every table has RLS enabled in its migration (deny-by-default for the
//     Supabase `anon` / `authenticated` roles).
//
// Phase 0 contains only cross-cutting foundations. Domain models are added by
// later phases, each with its own migration. Never use `prisma db push`
// against shared or production databases.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Append-only audit trail. UPDATE, DELETE and TRUNCATE are rejected by a
/// database trigger (see migration 20260925000000_phase0_foundation).
/// organization_id / user_id gain foreign keys when those tables are
/// introduced (Phases 1-2); they are nullable because platform-level events
/// (e.g. a failed login for an unknown email) have no tenant or user.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(64)
  module         String   @db.VarChar(64)
  recordId       String?  @map("record_id") @db.VarChar(128)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([module, recordId])
  @@map("audit_logs")
}
