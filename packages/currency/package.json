{
  "name": "@gap/currency",
  "version": "0.0.0",
  "private": true,
  "description": "Currency code value objects and historical-rate conversion. Currency data itself is database-driven.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@gap/money": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
