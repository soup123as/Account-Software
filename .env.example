# =============================================================================
# Global Accounting Platform — environment template
#
# Copy to `.env` for local development. NEVER commit `.env`.
# Production secrets live in the hosting provider / GitHub Environments.
#
# Only variables prefixed with VITE_ reach the browser bundle, and only the
# four allowlisted in apps/web/config/public-env.ts are permitted. Builds fail
# if any other VITE_ variable is defined. Never prefix a secret with VITE_.
# =============================================================================

NODE_ENV=development

APP_NAME="Global Accounting Platform"

APP_URL=http://localhost:5173

API_URL=http://localhost:3000

PORT=3000

API_PREFIX=api/v1


# --- Database (server-only) --------------------------------------------------
# Supabase: DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true),
#           DIRECT_DATABASE_URL = direct connection (port 5432) used by migrations.
# Local docker: both point to postgresql://gap:<password>@localhost:5432/gap_dev
DATABASE_URL=

DIRECT_DATABASE_URL=

# Throwaway database used only by `pnpm --filter @gap/database db:check-drift`.
SHADOW_DATABASE_URL=


# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=

SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# --- Sessions (Phase 1) ------------------------------------------------------
SESSION_SECRET=

AUTH_COOKIE_NAME=accounting_session


# --- Redis / queues ----------------------------------------------------------
REDIS_URL=

REDIS_HOST=localhost

REDIS_PORT=6379

REDIS_USERNAME=

REDIS_PASSWORD=


QUEUE_PREFIX=global-accounting

WORKER_CONCURRENCY=5

HEARTBEAT_INTERVAL_MS=60000


# --- Email (Phase 18) --------------------------------------------------------
SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM=

SMTP_FROM_NAME=

SMTP_SECURE=false


RESEND_API_KEY=


# --- Storage (Phase 18) ------------------------------------------------------
STORAGE_BUCKET_DOCUMENTS=documents

STORAGE_BUCKET_ATTACHMENTS=attachments

STORAGE_BUCKET_EXPORTS=exports


MAX_FILE_SIZE_MB=25


# --- Server-only secrets -----------------------------------------------------
ENCRYPTION_KEY=

INTERNAL_API_KEY=

WEBHOOK_SECRET=


# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000

RATE_LIMIT_MAX_REQUESTS=100


# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

LOG_FORMAT=json


# --- Browser (public by design) ----------------------------------------------
VITE_APP_NAME="Global Accounting Platform"

VITE_API_URL=http://localhost:3000/api/v1

VITE_SUPABASE_URL=

VITE_SUPABASE_ANON_KEY=


# --- Exchange rates (Phase 4) ------------------------------------------------
EXCHANGE_RATE_PROVIDER=

EXCHANGE_RATE_API_KEY=


# --- Error monitoring (Phase 20) ---------------------------------------------
SENTRY_DSN=

SENTRY_ENVIRONMENT=development


SEED_DATABASE=true

ENABLE_DEV_TOOLS=true
